  "main": "src/index.js",
  "scripts": {
    "test": "brittle-node test/*.test.js",
    "test:bare": "brittle-bare test/*.test.js"
  },
  "dependencies": {
    "bare-fs": "^4.7.2",
    "bare-path": "^3.0.1",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.1",
    "mdast-util-gfm-task-list-item": "^2.0.1",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0"
  },
  "devDependencies": {
    "brittle": "^4.0.2"
  },
  "bin": {
    "hypermd": "bin/hypermd.js"
  },
  "imports": {
